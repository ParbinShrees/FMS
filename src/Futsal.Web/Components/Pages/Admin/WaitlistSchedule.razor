@page "/admin/waitlist"
@inject ApiClient Api
@inject BffAuthState Auth
@inject Futsal.Application.Abstractions.IClock Clock
@inject Microsoft.Extensions.Localization.IStringLocalizer<Futsal.Web.Scheduling> N
<PageTitle>@N["WaitlistSchedule"]</PageTitle>
<h1>@N["WaitlistSchedule"]</h1><MudSelect T="Guid" Value="venue" ValueChanged="VenueChanged" Label="@N["Venue"]">@foreach(var v in venues){<MudSelectItem T="Guid" Value="v.Id">@v.Name</MudSelectItem>}</MudSelect><BsDatePicker Date="date.ToDateTime(TimeOnly.MinValue)" DateChanged="DateChanged"/><MudButton OnClick="Load">@N["Refresh"]</MudButton>
<SchedulingLiveRefresh Slug="@(venues.FirstOrDefault(x=>x.Id==venue)?.Slug)" Date="date" Refresh="Load"/><SlotGrid Slots="slots" Waitlist="entries"/>
<MudTable Items="entries"><HeaderContent><MudTh>@N["QueuePosition"]</MudTh><MudTh>@N["Customer"]</MudTh><MudTh>@N["Window"]</MudTh><MudTh>@N["Status"]</MudTh><MudTh>@N["Action"]</MudTh></HeaderContent><RowTemplate><MudTd>@context.Position</MudTd><MudTd>@context.Customer @context.Phone</MudTd><MudTd>@context.FromTimeLocal - @context.ToTimeLocal (@context.SlotsNeeded)</MudTd><MudTd>@N[context.Status] @if(context.OfferExpiresAt is {} expires&&context.Status=="OFFERED"){<HoldCountdown @key="context.Id" ExpiresAt="expires" OnExpired="Load"/>}</MudTd><MudTd>@if(context.RequiresApproval){<MudChip T="string" Color="Color.Warning">@N["NeedsApproval"]</MudChip>@if(Auth.Token?.Role is "Owner" or "Manager"){<MudButton OnClick="()=>Approve(context.Id)">@N["Approve"]</MudButton>}}@if(context.Status is "WAITING" or "OFFERED"){<MudButton OnClick="()=>Cancel(context.Id)">@N["CancelEntry"]</MudButton>}@if(context.Status=="OFFERED"){<MudButton OnClick="()=>Confirm(context.Id)">@N["ConfirmCashOffer"]</MudButton>}</MudTd></RowTemplate></MudTable>
<MudNumericField T="decimal" @bind-Value="payment" Label="@N["PaymentAmount"]"/><p>@N["CashOfferHelp"]</p>
<MudPaper Class="pa-4 my-4"><h2>@N["JoinOnBehalf"]</h2><MudSelect T="Guid" @bind-Value="customer" Label="@N["Customer"]">@foreach(var c in options.Customers){<MudSelectItem T="Guid" Value="c.Id">@c.Name @c.Phone</MudSelectItem>}</MudSelect><MudSelect T="Guid" @bind-Value="court" Label="@N["Court"]"><MudSelectItem T="Guid" Value="Guid.Empty">@N["AnyCourt"]</MudSelectItem>@foreach(var c in options.Courts){<MudSelectItem T="Guid" Value="c.Id">@c.Name</MudSelectItem>}</MudSelect><label>@N["FromTime"]<input type="time" value="@from" @onchange="e=>from=e.Value?.ToString()??string.Empty"/></label><label>@N["ToTime"]<input type="time" value="@to" @onchange="e=>to=e.Value?.ToString()??string.Empty"/></label><MudNumericField T="int" @bind-Value="needed" Label="@N["DurationSlots"]"/><MudButton Disabled="busy" OnClick="Join">@N["JoinWaitlist"]</MudButton></MudPaper>
@if(message!=null){<MudAlert Severity="Severity.Warning">@N[message]</MudAlert>}
@code{List<VenueDto> venues=[];List<WaitlistView> entries=[];List<AvailabilitySlotDto> slots=[];SchedulingOptions options=new([],[]);Guid venue,court,customer;DateOnly date;string from="19:00",to="20:00";int needed=1;decimal payment;bool busy;string? message;
protected override async Task OnInitializedAsync(){date=BsDate.KathmanduDate(Clock.UtcNow);try{venues=(await Api.GetVenuesAsync()).ToList();venue=venues.FirstOrDefault()?.Id??Guid.Empty;await Load();}catch{message="Failure";}}
async Task VenueChanged(Guid value){venue=value;await Load();}async Task DateChanged(DateTime? value){if(value==null)return;date=DateOnly.FromDateTime(value.Value);await Load();}
async Task Load(){try{entries=await Api.ManagementGetAsync<List<WaitlistView>>($"staff/waitlist?venueId={venue}&date={date:yyyy-MM-dd}")??[];options=await Api.ManagementGetAsync<SchedulingOptions>($"staff/recurring/options?venueId={venue}")??new([],[]);customer=options.Customers.FirstOrDefault()?.Id??Guid.Empty;var slug=venues.FirstOrDefault(x=>x.Id==venue)?.Slug;if(slug!=null)slots=(await Api.GetAvailabilityAsync(slug,date)).ToList();}catch(ApiProblemException ex){message=ex.Code;}}
async Task Act(Func<Task> action){busy=true;try{await action();message="Saved";await Load();}catch(ApiProblemException ex){message=ex.Code;}catch{message="VALIDATION_FAILED";}finally{busy=false;}}
async Task Join()=>await Act(async()=>await Api.SchedulingSendAsync<WaitlistView>("staff/waitlist",new WaitlistJoin(venue,court==Guid.Empty?null:court,date,TimeOnly.Parse(from),TimeOnly.Parse(to),needed,customer)));
async Task Approve(Guid id)=>await Act(async()=>await Api.SchedulingSendAsync<object>($"staff/waitlist/{id}/approve",new{}));
async Task Cancel(Guid id)=>await Act(async()=>await Api.SchedulingSendAsync<object>($"staff/waitlist/{id}/cancel",new{}));
async Task Confirm(Guid id)=>await Act(async()=>await Api.SchedulingSendAsync<object>($"staff/waitlist/{id}/confirm",new WaitlistConfirm(payment,"CASH")));}
