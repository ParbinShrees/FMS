@page "/admin/recurring/{Id:guid}"
@inject ApiClient Api
@inject BffAuthState Auth
@inject Futsal.Application.Abstractions.IClock Clock
@inject Microsoft.Extensions.Localization.IStringLocalizer<Futsal.Web.Scheduling> N
<PageTitle>@N["SeriesDetail"]</PageTitle>
<h1>@N["SeriesDetail"]</h1>
@if(detail!=null){<h2>@detail.Series.Customer - @detail.Series.Court</h2><p>@detail.Series.Notes</p><p>@N["StartDate"]: @BsDate.Display(detail.Series.StartDate) / @N["EndDateOptional"]: @(detail.Series.EndDate is {} endDate?BsDate.Display(endDate):N["OpenEnded"].Value)</p>@if(detail.Series.LockedPricePerOccurrence is decimal locked){<p>@N["LockedPrice"]: Rs @locked.ToString("N2")</p>}<p>@N[detail.Series.Status] / @N[detail.Series.PriceMode] ? @N["PauseHelp"]</p>
<MudButton Disabled="busy" OnClick='()=>State("pause")'>@N["Pause"]</MudButton><MudButton Disabled="busy" OnClick='()=>State("resume")'>@N["Resume"]</MudButton><MudDatePicker @bind-Date="from" Label="@N["ApplyFrom"]"/><p>@(from==null?"":BsDate.Display(DateOnly.FromDateTime(from.Value)))</p><MudButton Disabled="busy" OnClick='()=>State("end")'>@N["EndFrom"]</MudButton>@if(Auth.Token?.Role is "Owner" or "Manager"){<MudButton Disabled="busy" OnClick='()=>State("delete")'>@N["DeleteSeries"]</MudButton>}
<h2>@N["OccurrenceCalendar"]</h2><OccurrenceCalendar Occurrences="detail.Occurrences" Selected="Select"/><MudTable Items="detail.Occurrences"><HeaderContent><MudTh>@N["Date"]</MudTh><MudTh>@N["Status"]</MudTh><MudTh>@N["Price"]</MudTh><MudTh>@N["Paid"]</MudTh><MudTh>@N["Action"]</MudTh></HeaderContent><RowTemplate><MudTd>@BsDate.Display(context.Date) @if(context.StartUtc is {} at){<div>@BsDate.Display(at)</div>}</MudTd><MudTd>@N[context.Status] @if(context.Reason!=null){<div>@N[context.Reason]</div>}</MudTd><MudTd>Rs @context.Total.ToString("N2")</MudTd><MudTd>Rs @context.Paid.ToString("N2")</MudTd><MudTd><MudButton OnClick="()=>Select(context)">@N["Select"]</MudButton></MudTd></RowTemplate></MudTable>
@if(selected!=null){<MudPaper Class="pa-4 my-3"><h3>@BsDate.Display(selected.Date)</h3><MudTextField T="string" @bind-Value="reason" Label="@N["Reason"]"/><MudButton Disabled="busy" OnClick='()=>Occurrence("skip")'>@N["SkipDate"]</MudButton><MudButton Disabled="busy" OnClick='()=>Occurrence("cancel")'>@N["CancelOne"]</MudButton><MudDatePicker @bind-Date="moveDate" Label="@N["MoveDate"]"/><label>@N["LocalTime"]<input type="time" value="@moveTime" @onchange="e=>moveTime=e.Value?.ToString()??string.Empty"/></label><MudButton Disabled="busy" OnClick='()=>Occurrence("move")'>@N["MoveOne"]</MudButton>
@if(selected.BookingId!=null&&selected.Status=="CONFIRMED"){<MudNumericField T="decimal" @bind-Value="payment" Label="@N["PaymentAmount"]"/><MudSelect T="string" @bind-Value="method" Label="@N["Method"]">@foreach(var m in new[]{"CASH","BANK","OTHER"}){<MudSelectItem T="string" Value="@m">@N[m]</MudSelectItem>}</MudSelect><MudButton Disabled="busy" OnClick="PayOne">@N["RecordPayment"]</MudButton>}</MudPaper>}
<MudPaper Class="pa-4 my-3"><h2>@N["ChangeFuture"]</h2><p>@N["ChangeHelp"]</p><MudSelect T="Guid" @bind-Value="court" Label="@N["Court"]">@foreach(var c in options.Courts){<MudSelectItem T="Guid" Value="c.Id">@c.Name</MudSelectItem>}</MudSelect><label>@N["LocalTime"]<input type="time" value="@time" @onchange="e=>time=e.Value?.ToString()??string.Empty"/></label><MudNumericField T="int" @bind-Value="slots" Label="@N["DurationSlots"]"/><MudButton Disabled="busy" OnClick="Change">@N["ApplyChange"]</MudButton>@if(report.Count>0){<SeriesPreview Dates="report"/>}</MudPaper>
<MudPaper Class="pa-4 my-3"><h2>@N["PrepaidBlock"]</h2><p>@N["PrepaidHelp"]</p><MudNumericField T="int" @bind-Value="weeks" Label="@N["Weeks"]"/><MudNumericField T="decimal" @bind-Value="amount" Label="@N["PaymentAmount"]"/><MudSelect T="string" @bind-Value="method" Label="@N["Method"]">@foreach(var m in new[]{"CASH","BANK","OTHER"}){<MudSelectItem T="string" Value="@m">@N[m]</MudSelectItem>}</MudSelect><MudButton Disabled="busy" OnClick="Prepay">@N["RecordPrepayment"]</MudButton>
<MudNumericField T="decimal" @bind-Value="refund" Label="@N["RefundAmount"]"/><MudTable Items="detail.Allocations"><HeaderContent><MudTh>@N["Block"]</MudTh><MudTh>@N["Date"]</MudTh><MudTh>@N["Allocated"]</MudTh><MudTh>@N["Action"]</MudTh></HeaderContent><RowTemplate><MudTd><code>@context.BlockId.ToString()[..8]</code></MudTd><MudTd>@BsDate.Display(context.StartUtc)</MudTd><MudTd>Rs @context.Amount.ToString("N2")</MudTd><MudTd>@if(context.Amount>0&&Auth.Token?.Role is "Owner" or "Manager"){<MudButton Disabled="busy" OnClick="()=>Refund(context.PaymentId)">@N["RecordRefund"]</MudButton>}</MudTd></RowTemplate></MudTable></MudPaper>}
@if(message!=null){<MudAlert Severity="Severity.Warning">@N[message]</MudAlert>}
@code{[Parameter]public Guid Id{get;set;}SeriesDetail? detail;SeriesOccurrence? selected;SchedulingOptions options=new([],[]);string? message;DateTime? from,moveDate;string time="19:00",moveTime="19:00",reason="",method="CASH";Guid court;int slots=1,weeks=4;decimal amount,payment,refund;bool busy;List<SeriesDatePreview> report=[];
protected override async Task OnParametersSetAsync(){from=BsDate.KathmanduDate(Clock.UtcNow).ToDateTime(TimeOnly.MinValue);await Load();}
async Task Load(){detail=await Api.ManagementGetAsync<SeriesDetail>($"staff/recurring/{Id}");if(detail!=null){options=await Api.ManagementGetAsync<SchedulingOptions>($"staff/recurring/options?venueId={detail.Series.VenueId}")??new([],[]);court=detail.Series.CourtId;time=detail.Series.StartTimeLocal.ToString("HH:mm");slots=detail.Series.DurationSlots;}}
void Select(SeriesOccurrence value){selected=value;moveDate=value.Date.ToDateTime(TimeOnly.MinValue);moveTime=value.StartUtc==null?"19:00":TimeZoneInfo.ConvertTimeBySystemTimeZoneId(value.StartUtc.Value,"Asia/Kathmandu").ToString("HH:mm");}
async Task Act(Func<Task> action){busy=true;try{await action();message="Saved";await Load();}catch(ApiProblemException ex){message=ex.Code;}catch{message="VALIDATION_FAILED";}finally{busy=false;}}
async Task State(string action)=>await Act(async()=>await Api.SchedulingSendAsync<object>($"staff/recurring/{Id}"+(action=="delete"?"":"/state/"+action),new SeriesFromDate(DateOnly.FromDateTime(from!.Value),reason),method:action=="delete"?"DELETE":"POST"));
async Task Occurrence(string action)=>await Act(async()=>{DateTimeOffset? moved=action=="move"?Futsal.Application.Scheduling.SeriesCalendar.Utc(DateOnly.FromDateTime(moveDate!.Value),TimeOnly.Parse(moveTime),"Asia/Kathmandu"):null;await Api.SchedulingSendAsync<object>($"staff/recurring/{Id}/dates/{action}",new SeriesDateAction(selected!.Date,reason,moved));selected=null;});
async Task Change(){busy=true;try{report=await Api.SchedulingSendAsync<List<SeriesDatePreview>>($"staff/recurring/{Id}/change",new SeriesChange(DateOnly.FromDateTime(from!.Value),court,TimeOnly.Parse(time),slots))??[];message=report.Any(x=>x.Result!="FREE")?"SERIES_CHANGE_CONFLICT":"Saved";await Load();}catch(ApiProblemException ex){message=ex.Code;}catch{message="VALIDATION_FAILED";}finally{busy=false;}}
async Task Prepay()=>await Act(async()=>await Api.SchedulingSendAsync<List<PrepaymentAllocation>>($"staff/recurring/{Id}/prepay",new SeriesPrepay(weeks,amount,method)));
async Task PayOne()=>await Act(async()=>await Api.SchedulingSendAsync<object>($"staff/bookings/{selected!.BookingId}/payments",new{amount=payment,method,reference=reason}));
async Task Refund(Guid paymentId)=>await Act(async()=>await Api.RecordPaymentRefundAsync(paymentId,refund,method,reason));}
