@page "/admin/recurring"
@inject ApiClient Api
@inject BffAuthState Auth
@inject NavigationManager Nav
@inject Futsal.Application.Abstractions.IClock Clock
@inject Microsoft.Extensions.Localization.IStringLocalizer<Futsal.Web.Scheduling> N
<PageTitle>@N["Recurring"]</PageTitle>
<h1>@N["Recurring"]</h1>
<MudSelect T="Guid" Value="venue" ValueChanged="VenueChanged" Label="@N["Venue"]">@foreach(var v in venues){<MudSelectItem T="Guid" Value="v.Id">@v.Name</MudSelectItem>}</MudSelect>
<MudSelect T="string" Value="filter" ValueChanged="FilterChanged" Label="@N["Status"]">@foreach(var s in new[]{"ALL","ACTIVE","PAUSED","ENDED"}){<MudSelectItem T="string" Value="@s">@N[s]</MudSelectItem>}</MudSelect><MudButton OnClick="Load">@N["Refresh"]</MudButton>
<MudTable Items="FilteredSeries"><HeaderContent><MudTh>@N["Customer"]</MudTh><MudTh>@N["Court"]</MudTh><MudTh>@N["Status"]</MudTh><MudTh>@N["Conflicts"]</MudTh></HeaderContent><RowTemplate><MudTd><a href="@($"/admin/recurring/{context.Id}")">@context.Customer</a></MudTd><MudTd>@context.Court @N["Day"+context.Weekday] @context.StartTimeLocal</MudTd><MudTd>@N[context.Status]</MudTd><MudTd>@context.Conflicts</MudTd></RowTemplate></MudTable>
<MudPaper Class="pa-4 my-4"><h2>@N["CreateSeries"]</h2><p>@N["Step"] @(step+1) / 2</p>
@if(step==0){<MudSelect T="Guid" @bind-Value="court" Label="@N["Court"]">@foreach(var c in options.Courts){<MudSelectItem T="Guid" Value="c.Id">@c.Name</MudSelectItem>}</MudSelect><MudSelect T="Guid" @bind-Value="customer" Label="@N["Customer"]">@foreach(var c in options.Customers){<MudSelectItem T="Guid" Value="c.Id">@c.Name @c.Phone</MudSelectItem>}</MudSelect><MudSelect T="short" @bind-Value="weekday" Label="@N["Weekday"]">@for(short d=0;d<7;d++){var day=d;<MudSelectItem T="short" Value="day">@N["Day"+day]</MudSelectItem>}</MudSelect><label>@N["LocalTime"]<input type="time" value="@time" @onchange="e=>time=e.Value?.ToString()??string.Empty"/></label><MudNumericField T="int" @bind-Value="slots" Label="@N["DurationSlots"]"/><MudDatePicker @bind-Date="start" Label="@N["StartDate"]"/><p>@(start==null?"":BsDate.Display(DateOnly.FromDateTime(start.Value)))</p><MudDatePicker @bind-Date="end" Label="@N["EndDateOptional"]" Clearable="true"/><p>@(end==null?N["OpenEnded"].Value:BsDate.Display(DateOnly.FromDateTime(end.Value)))</p><MudSelect T="string" @bind-Value="mode" Label="@N["PriceMode"]"><MudSelectItem T="string" Value='@("CURRENT")'>@N["CURRENT"]</MudSelectItem><MudSelectItem T="string" Value='@("LOCKED")'>@N["LOCKED"]</MudSelectItem></MudSelect><MudCheckBox T="bool" @bind-Value="discount" Label="@N["RegularDiscount"]"/><MudTextField T="string" @bind-Value="notes" Label="@N["Notes"]"/><MudButton Disabled="busy" OnClick="Preview">@N["Preview"]</MudButton>}
else{<SeriesPreview Dates="preview"/><MudCheckBox T="bool" @bind-Value="freeOnly" Label="@N["CreateFreeOnly"]"/><MudButton Disabled="busy" OnClick="Create">@N["CreateSeries"]</MudButton><MudButton OnClick="()=>step=0">@N["CancelPreview"]</MudButton>}
</MudPaper>
@if(Auth.Token?.Role is "Owner" or "Manager"){<MudPaper Class="pa-4"><h2>@N["SchedulingSettings"]</h2><MudNumericField T="int" @bind-Value="horizon" Label="@N["HorizonWeeks"]"/><MudNumericField T="int" @bind-Value="offer" Label="@N["OfferMinutes"]"/><MudNumericField T="int" @bind-Value="threshold" Label="@N["NoShowThreshold"]"/><MudCheckBox T="bool" @bind-Value="summary" Label="@N["WeeklySummary"]"/><MudButton OnClick="SaveSettings">@N["Save"]</MudButton></MudPaper>}
@if(message!=null){<MudAlert Severity="Severity.Warning">@N[message]</MudAlert>}
@code{IEnumerable<SeriesListItem> FilteredSeries=>series.Where(x=>filter=="ALL"||x.Status==filter);List<VenueDto> venues=[];List<SeriesListItem> series=[];SchedulingOptions options=new([],[]);Guid venue,court,customer;string filter="ALL",time="19:00",mode="CURRENT",notes="";short weekday=5;int slots=1,step,horizon=8,offer=15,threshold=3;DateTime? start,end;bool discount=true,freeOnly,busy,summary;string? message;List<SeriesDatePreview> preview=[];
protected override async Task OnInitializedAsync(){start=BsDate.KathmanduDate(Clock.UtcNow).ToDateTime(TimeOnly.MinValue);try{venues=(await Api.GetVenuesAsync()).ToList();venue=venues.FirstOrDefault()?.Id??Guid.Empty;await Load();}catch{message="Failure";}}
async Task FilterChanged(string value){filter=value;await Load();}
async Task VenueChanged(Guid value){venue=value;step=0;await Load();}async Task Load(){try{series=await Api.ManagementGetAsync<List<SeriesListItem>>($"staff/recurring?venueId={venue}"+(filter=="ALL"?"":"&status="+filter))??[];options=await Api.ManagementGetAsync<SchedulingOptions>($"staff/recurring/options?venueId={venue}")??new([],[]);court=options.Courts.FirstOrDefault()?.Id??Guid.Empty;customer=options.Customers.FirstOrDefault()?.Id??Guid.Empty;var settings=await Api.ManagementGetAsync<SchedulingSettings>($"staff/recurring/venues/{venue}/settings");if(settings!=null){horizon=settings.HorizonWeeks;offer=settings.OfferMinutes;threshold=settings.NoShowThreshold;summary=settings.WeeklySummary;}}catch(ApiProblemException ex){message=ex.Code;}}
SeriesWrite Input()=>new(court,customer,weekday,TimeOnly.Parse(time),slots,DateOnly.FromDateTime(start!.Value),end==null?null:DateOnly.FromDateTime(end.Value),mode,discount,notes);
async Task Preview(){busy=true;try{preview=await Api.SchedulingSendAsync<List<SeriesDatePreview>>("staff/recurring/preview",Input())??[];step=1;message=null;}catch(ApiProblemException ex){message=ex.Code;}catch{message="VALIDATION_FAILED";}finally{busy=false;}}
async Task Create(){busy=true;try{var result=await Api.SchedulingSendAsync<SeriesCreateResult>("staff/recurring",new SeriesCreate(Input(),freeOnly));if(result?.Id is Guid id)Nav.NavigateTo("/admin/recurring/"+id);else{preview=result?.Dates??[];message="REVIEW_CONFLICTS";}}catch(ApiProblemException ex){message=ex.Code;}finally{busy=false;}}
async Task SaveSettings(){try{await Api.SchedulingSendAsync<object>($"staff/recurring/venues/{venue}/settings",new SchedulingSettings(horizon,offer,threshold,summary),method:"PUT");message="Saved";}catch(ApiProblemException ex){message=ex.Code;}}}
