@page "/admin/onboarding"
@using Futsal.Contracts
@inject Futsal.Web.Services.ApiClient Api
@inject Microsoft.Extensions.Localization.IStringLocalizer<Futsal.Web.Pilot> P
<h1>@P["Onboarding"]</h1>
@if(loading){<MudProgressLinear Indeterminate="true" aria-label="@P["Loading"]"/>}else if(complete){<MudAlert Severity="Severity.Success">@P["Ready"]</MudAlert><ul>@foreach(var key in new[]{"ProfileReady","CourtsReady","HoursReady","PricingReady","PolicyReady","PaymentOptional","InvitesReady"}){<li>@P[key]</li>}</ul><MudButton Href="/admin">@P["Schedule"]</MudButton><MudButton Href="/admin/payment-settings">@P["PaymentSettings"]</MudButton>@foreach(var link in links){<p>@link.Email <code>@($"{Navigation.BaseUri}staff-invite#{link.Token}")</code></p>}}
else{
<p>@P["Step"] @(step+1) / 7 ? @P[steps[step]]</p><MudProgressLinear Value="@((step+1)*100d/7)" aria-label="@P["Progress"]"/>
@if(step==0){<MudTextField T="string" @bind-Value="name" Label="@P["VenueName"]"/><MudTextField T="string" @bind-Value="slug" Label="@P["Slug"]"/><MudSelect T="Guid" @bind-Value="location" Label="@P["Location"]">@foreach(var l in locations){<MudSelectItem T="Guid" Value="l.Id">@l.NameEn @l.NameNe</MudSelectItem>}</MudSelect><MudTextField T="string" @bind-Value="address" Label="@P["Address"]"/>}
@if(step==1){@foreach(var c in courts){<MudPaper Class="pa-3 my-2"><MudTextField T="string" @bind-Value="c.Name" Label="@P["Court"]"/><MudNumericField T="decimal" @bind-Value="c.Price" Label="@P["DefaultPrice"]"/><MudSelect T="int" @bind-Value="c.Minutes" Label="@P["SlotMinutes"]">@foreach(var m in new[]{30,60,90}){<MudSelectItem T="int" Value="m">@m</MudSelectItem>}</MudSelect><MudButton OnClick="()=>courts.Remove(c)">@P["Remove"]</MudButton></MudPaper>}<MudButton OnClick="()=>courts.Add(new())">@P["AddCourt"]</MudButton>}
@if(step==2){@foreach(var h in hours){<div class="d-flex gap-3 my-2"><MudCheckBox T="bool" @bind-Value="h.Enabled" Label="@P["Day"+h.Day]"/><label>@P["Open"]<input type="time" value="@h.Open" @onchange="e=>h.Open=e.Value?.ToString()??string.Empty"/></label><label>@P["Close"]<input type="time" value="@h.Close" @onchange="e=>h.Close=e.Value?.ToString()??string.Empty"/></label></div>}}
@if(step==3){<p>@P["PriceHelp"]</p>@foreach(var r in prices){<MudPaper Class="pa-3 my-2"><MudNumericField T="int" @bind-Value="r.CourtIndex" Label="@P["CourtIndex"]"/><MudTextField T="string" @bind-Value="r.Name" Label="@P["RuleName"]"/><MudTextField T="string" @bind-Value="r.Days" Label="@P["Weekdays"]"/><label>@P["Open"]<input type="time" value="@r.From" @onchange="e=>r.From=e.Value?.ToString()??string.Empty"/></label><label>@P["Close"]<input type="time" value="@r.To" @onchange="e=>r.To=e.Value?.ToString()??string.Empty"/></label><MudNumericField T="decimal" @bind-Value="r.Price" Label="@P["DefaultPrice"]"/><MudNumericField T="int" @bind-Value="r.Priority" Label="@P["Priority"]"/><MudButton OnClick="()=>prices.Remove(r)">@P["Remove"]</MudButton></MudPaper>}<MudButton OnClick="()=>prices.Add(new())">@P["AddRule"]</MudButton>}
@if(step==4){<MudNumericField T="int" @bind-Value="cancel" Label="@P["Cancellation"]"/><MudSelect T="string" @bind-Value="advanceType" Label="@P["AdvanceType"]"><MudSelectItem T="string" Value='@("PERCENT")'>@P["Percent"]</MudSelectItem><MudSelectItem T="string" Value='@("FIXED")'>@P["FixedAdvance"]</MudSelectItem></MudSelect><MudNumericField T="decimal" @bind-Value="advance" Label="@P["AdvanceValue"]"/>}
@if(step==5){<p>@P["PaymentOptional"]</p><MudCheckBox T="bool" @bind-Value="configurePayment" Label="@P["ConfigurePayment"]"/>@if(configurePayment){<MudTextField T="string" @bind-Value="merchant" Label="@P["Merchant"]"/><MudTextField T="string" @bind-Value="secret" InputType="InputType.Password" Label="@P["Secret"]"/><p>@P["SecretNotSaved"]</p>}}
@if(step==6){@foreach(var s in staff){<MudTextField T="string" @bind-Value="s.Email" Label="@P["Email"]"/><MudSelect T="string" @bind-Value="s.Role" Label="@P["Role"]"><MudSelectItem T="string" Value='@("Cashier")'>@P["Cashier"]</MudSelectItem><MudSelectItem T="string" Value='@("Manager")'>@P["Manager"]</MudSelectItem></MudSelect><MudButton OnClick="()=>staff.Remove(s)">@P["Remove"]</MudButton>}<MudButton OnClick="()=>staff.Add(new())">@P["AddStaff"]</MudButton><p>@P["InviteHelp"]</p>}
<MudButton Disabled="@(busy||step==0)" OnClick="Back">@P["Back"]</MudButton><MudButton Disabled="busy" OnClick="Save">@P["SaveResume"]</MudButton>@if(step<6){<MudButton Disabled="busy" OnClick="Next">@P["Next"]</MudButton>}else{<MudButton Disabled="busy" OnClick="Finish">@P["Finish"]</MudButton>}}
@if(error!=null){<MudAlert Severity="Severity.Error">@P[error]</MudAlert>}
@inject NavigationManager Navigation
@code{
string[] steps=["Profile","Courts","Hours","Pricing","Policies","PaymentSettings","Staff"];int step,cancel=6;bool busy,loading=true,complete,configurePayment;string? error;string name="",slug="",address="",advanceType="PERCENT",merchant="",secret="";decimal advance=30;Guid location;List<Futsal.Web.Services.LocationItemDto> locations=[];List<CourtForm> courts=[new()];List<HourForm> hours=Enumerable.Range(0,7).Select(i=>new HourForm{Day=(short)i}).ToList();List<PriceForm> prices=[];List<StaffForm> staff=[];List<InviteLink> links=[];
sealed class CourtForm{public string Name{get;set;}="";public decimal Price{get;set;}=1500;public int Minutes{get;set;}=60;}
sealed class HourForm{public short Day{get;set;}public bool Enabled{get;set;}=true;public string Open{get;set;}="06:00";public string Close{get;set;}="23:00";}
sealed class PriceForm{public int CourtIndex{get;set;}public string Name{get;set;}="";public string Days{get;set;}="0,1,2,3,4,5,6";public string From{get;set;}="17:00";public string To{get;set;}="22:00";public decimal Price{get;set;}=2000;public int Priority{get;set;}=1;}
sealed class StaffForm{public string Email{get;set;}="";public string Role{get;set;}="Cashier";}
protected override async Task OnInitializedAsync(){try{locations=await Api.ManagementGetAsync<List<Futsal.Web.Services.LocationItemDto>>("pilot/onboarding/locations")??[];var state=await Api.ManagementGetAsync<OnboardingView>("pilot/onboarding");if(state!=null){step=state.Step;complete=state.Complete;if(state.Draft is {} d){name=d.Name;slug=d.Slug;location=d.LocationId;address=d.Address;cancel=d.FreeCancelHours;advance=d.AdvanceValue;advanceType=d.AdvanceType;courts=d.Courts.Select(c=>new CourtForm{Name=c.Name,Price=c.Price,Minutes=c.SlotMinutes}).ToList();foreach(var h in hours){var old=d.Hours.SingleOrDefault(x=>x.Weekday==h.Day);h.Enabled=old!=null;if(old!=null){h.Open=old.Open.ToString("HH:mm");h.Close=old.Close.ToString("HH:mm");}}prices=d.Prices.Select(p=>new PriceForm{CourtIndex=p.CourtIndex,Name=p.Name,Days=string.Join(",",p.Weekdays),From=p.From.ToString("HH:mm"),To=p.To.ToString("HH:mm"),Price=p.Price,Priority=p.Priority}).ToList();staff=(d.Staff??[]).Select(x=>new StaffForm{Email=x.Email,Role=x.Role}).ToList();}}}catch{error="Failure";}finally{loading=false;}}
OnboardingDraft Draft()=>new(name,slug,location,address,courts.Select(c=>new PilotCourt(c.Name,c.Price,c.Minutes)).ToList(),hours.Where(h=>h.Enabled).Select(h=>new PilotHours(h.Day,TimeOnly.Parse(h.Open),TimeOnly.Parse(h.Close))).ToList(),prices.Select(p=>new PilotPrice(p.CourtIndex,p.Name,p.Days.Split(',').Select(short.Parse).ToArray(),TimeOnly.Parse(p.From),TimeOnly.Parse(p.To),p.Price,p.Priority)).ToList(),cancel,advanceType,advance,staff.Select(s=>new PilotInvite(s.Email,s.Role)).ToList());
async Task<bool> Persist(){try{await Api.ManagementSendAsync<object>("pilot/onboarding",new OnboardingSave(step,Draft()),true);error=null;return true;}catch(Futsal.Web.Services.ApiProblemException ex){error=ex.Code;}catch{error="VALIDATION_FAILED";}return false;}
async Task Save(){busy=true;await Persist();busy=false;}async Task Next(){busy=true;if(await Persist()){step++;await Persist();}busy=false;}async Task Back(){busy=true;step--;await Persist();busy=false;}
async Task Finish(){busy=true;try{if(await Persist()){var result=await Api.ManagementSendAsync<OnboardingResult>("pilot/onboarding/finish",new{});if(result!=null){complete=true;links=result.Invites;if(configurePayment)await Api.UpdateVenuePaymentSettingsAsync(result.VenueId,new(true,merchant,secret));secret="";}}}catch(Futsal.Web.Services.ApiProblemException ex){error=ex.Code;}catch{error="Failure";}finally{busy=false;}}
}
