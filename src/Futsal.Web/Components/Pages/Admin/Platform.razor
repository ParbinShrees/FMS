@page "/admin/platform"
@using System.Text.Json
@inject Futsal.Web.Services.ApiClient Api
@inject Futsal.Application.Abstractions.IClock Clock
@inject Microsoft.Extensions.Localization.IStringLocalizer<Futsal.Web.Milestone9> L
<h1>@L["Platform"]</h1><MudButton OnClick="Load">@L["Load"]</MudButton><MudTable Items="rows"><HeaderContent><MudTh>@L["Name"]</MudTh><MudTh>@L["Status"]</MudTh><MudTh>@L["Load"]</MudTh></HeaderContent><RowTemplate><MudTd>@context.GetProperty("name").GetString()</MudTd><MudTd>@context.ToString()</MudTd><MudTd><MudButton OnClick="()=>Edit(context)">@L["Load"]</MudButton></MudTd></RowTemplate></MudTable>
<MudTextField T="string" @bind-Value="name" Label="@L["Name"]"/><MudTextField T="string" @bind-Value="plan" Label="@L["Plan"]"/><MudSelect T="string" @bind-Value="status" Label="@L["Status"]">@foreach(var s in new[]{"TRIAL","ACTIVE","PAST_DUE","CANCELLED"}){<MudSelectItem T="string" Value="@s">@s</MudSelectItem>}</MudSelect><MudDatePicker @bind-Date="start" Label="@L["Starts"]"/><MudDatePicker @bind-Date="end" Label="@L["Ends"]"/><MudNumericField T="int" @bind-Value="max" Label="@L["MaxCourts"]"/><MudNumericField T="int" @bind-Value="grace" Label="@L["Grace"]"/><MudSwitch T="bool" @bind-Value="suspended" Label="@L["Suspended"]"/><MudNumericField T="decimal?" @bind-Value="manualPayment" Label="@L["ManualPayment"]"/><MudTextField T="string" @bind-Value="reference" Label="@L["Reference"]"/><MudButton OnClick="Save">@L["Save"]</MudButton>@if(error){<MudAlert Severity="Severity.Error">@L["Failure"]</MudAlert>}
@code{List<JsonElement> rows=[];Guid? id;string name="",plan="Basic",status="TRIAL";DateTime? start,end;decimal? manualPayment;string reference="";
protected override void OnInitialized(){start=Clock.UtcNow.UtcDateTime.Date;end=start.Value.AddDays(30);}
int max=2,grace=7;bool suspended,error;
async Task Load(){try{rows=await Api.ManagementGetAsync<List<JsonElement>>("platform/organizations")??[];}catch{error=true;}}
void Edit(JsonElement x){id=x.GetProperty("id").GetGuid();name=x.GetProperty("name").GetString()??"";suspended=x.GetProperty("status").GetString()=="SUSPENDED";var s=x.GetProperty("subscription");if(s.ValueKind!=JsonValueKind.Null){plan=s.GetProperty("plan").GetString()??"Basic";status=s.GetProperty("status").GetString()??"TRIAL";max=s.GetProperty("maxCourts").GetInt32();grace=s.GetProperty("graceDays").GetInt32();end=s.GetProperty("endsAt").ValueKind==JsonValueKind.Null?null:s.GetProperty("endsAt").GetDateTimeOffset().UtcDateTime;}}
async Task Save(){try{await Api.ManagementSendAsync<JsonElement>("platform/organizations"+(id==null?"":"/"+id),new{name,plan,status,startsAt=new DateTimeOffset(DateTime.SpecifyKind(start??Clock.UtcNow.UtcDateTime,DateTimeKind.Utc)),endsAt=end==null?(DateTimeOffset?)null:new DateTimeOffset(DateTime.SpecifyKind(end.Value,DateTimeKind.Utc)),maxCourts=max,graceDays=grace,suspended,manualPayment,reference},id!=null);error=false;await Load();}catch{error=true;}}}
