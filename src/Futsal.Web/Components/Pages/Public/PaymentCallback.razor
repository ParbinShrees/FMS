@page "/v/callback/esewa"
@layout Futsal.Web.Components.Layout.PlayerLayout
@using Futsal.Contracts
@using Futsal.Web.Services
@inject ApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Payment Confirmation — FutsalPro</PageTitle>

<div class="payment-callback pa-4">
    @if (IsVerifying)
    {
        <div class="d-flex flex-column align-center justify-center pa-8">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" Class="mb-4" />
            <MudText Typo="Typo.h6">Verifying your payment with eSewa...</MudText>
            <MudText Typo="Typo.body2" Class="text-secondary">Please wait, do not close or refresh this tab.</MudText>
        </div>
    }
    else if (VerificationResult != null && VerificationResult.IsSuccess)
    {
        <MudCard Elevation="3" Class="pa-4 text-center">
            <div class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Style="font-size: 64px;" />
            </div>

            <MudText Typo="Typo.h5" Class="font-weight-bold text-success mb-1">
                Booking Confirmed!
            </MudText>
            <MudText Typo="Typo.body2" Class="text-secondary mb-4">
                Your court advance has been received and your slot is booked.
            </MudText>

            <MudDivider Class="my-3" />

            <div class="d-flex flex-column gap-2 text-left my-4">
                <div class="d-flex justify-space-between">
                    <span class="text-secondary">Booking Code:</span>
                    <strong class="text-primary font-weight-bold" style="font-size: 1.1rem;">@VerificationResult.BookingCode</strong>
                </div>
                <div class="d-flex justify-space-between">
                    <span class="text-secondary">Status:</span>
                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">CONFIRMED</MudChip>
                </div>
            </div>

            <MudDivider Class="my-3" />

            <div class="d-flex flex-column gap-2 mt-4">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Event"
                           OnClick="DownloadCalendarFile">
                    Add to Calendar (.ics)
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           Href="/v/my-bookings">
                    View My Bookings
                </MudButton>

                <MudButton Variant="Variant.Text"
                           Color="Color.Default"
                           Href="/v">
                    Book Another Court
                </MudButton>
            </div>
        </MudCard>
    }
    else if (VerificationResult != null && VerificationResult.NeedsRefund)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="pa-4">
            <MudText Typo="Typo.h6">Hold Expired — Payment Marked for Refund</MudText>
            <MudText Typo="Typo.body2" Class="mt-2">
                Your payment was received, but the hold expired and the slot was taken by another player.
                Your advance has been marked as <strong>NEEDS REFUND</strong>. The front desk staff will contact you to process your refund.
            </MudText>
            <div class="mt-4">
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Href="/v">
                    Return to Courts
                </MudButton>
            </div>
        </MudAlert>
    }
    else
    {
        <MudCard Elevation="2" Class="pa-4 text-center">
            <div class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Style="font-size: 64px;" />
            </div>

            <MudText Typo="Typo.h6" Class="text-danger mb-2">Payment Verification Failed</MudText>
            <MudText Typo="Typo.body2" Class="text-secondary mb-4">
                @(ErrorMessage ?? "We could not verify your transaction with eSewa. If money was deducted, please contact front desk with your eSewa transaction code.")
            </MudText>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/v">
                Return to Search
            </MudButton>
        </MudCard>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "data")]
    public string? CallbackData { get; set; }

    private bool IsVerifying { get; set; } = true;
    private VerifyPaymentResponseDto? VerificationResult { get; set; }
    private string? ErrorMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(CallbackData))
        {
            IsVerifying = false;
            ErrorMessage = "No payment verification data was returned by eSewa.";
            return;
        }

        try
        {
            VerificationResult = await Api.VerifyEsewaPaymentAsync(CallbackData);
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsVerifying = false;
        }
    }

    private async Task DownloadCalendarFile()
    {
        if (VerificationResult == null) return;
        var code = VerificationResult.BookingCode;
        var icsContent = $@"BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//FutsalPro//Court Booking//EN
BEGIN:VEVENT
UID:{VerificationResult.BookingId}@futsalpro.com
DTSTAMP:{DateTime.UtcNow:yyyyMMddTHHmmssZ}
SUMMARY:Futsal Game (Booking: {code})
DESCRIPTION:FutsalPro court booking confirmed. Booking code: {code}.
STATUS:CONFIRMED
END:VEVENT
END:VCALENDAR";

        var bytes = System.Text.Encoding.UTF8.GetBytes(icsContent);
        var base64 = Convert.ToBase64String(bytes);
        var href = $"data:text/calendar;charset=utf-8;base64,{base64}";
        await JS.InvokeVoidAsync("eval", $"let a = document.createElement('a'); a.href = '{href}'; a.download = 'futsal-booking-{code}.ics'; document.body.appendChild(a); a.click(); document.body.removeChild(a);");
    }
}
