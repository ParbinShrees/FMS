# DNS hostname for automatic HTTPS
SITE_HOST=

# TLS renewal contact
ACME_EMAIL=

# immutable API image tag/digest
API_IMAGE=

# immutable Web image tag/digest
WEB_IMAGE=

# backup image tag/digest
BACKUP_IMAGE=

# strong PostgreSQL administrator password
POSTGRES_ADMIN_PASSWORD=

# strong app role password, at least 20 characters
APP_DB_PASSWORD=

# strong separate migration role password
MIGRATION_DB_PASSWORD=

# read-only backup role password
BACKUP_DB_PASSWORD=

# random unique JWT key, at least 32 characters
JWT_SIGNING_KEY=

# absolute host path to protected PFX certificate
PAYMENT_KEY_FILE=

# strong PFX password, at least 20 characters
PAYMENT_KEY_PASSWORD=

# Community, Professional or Enterprise as eligible
PDF_LICENSE=

# confirmed HTTPS SMS API endpoint
SMS_PROVIDER_URL=

# SMS provider credential
SMS_API_KEY=

# approved production sender ID
SMS_SENDER_ID=

# true only after testing provider adapter
SMS_CONTRACT_CONFIRMED=

# Production eSewa signed-form endpoint (confirm with eSewa)
ESEWA_FORM_URL=

# Production eSewa server-side status endpoint
ESEWA_STATUS_URL=

# absolute host backup directory, owned by postgres container user
BACKUP_PATH=

# age public recipient used for encryption
BACKUP_RECIPIENT=

# age secret identity for scratch restore only; never needed by backup job
BACKUP_IDENTITY=

# database hostname for manual backup/restore
PGHOST=

# database port for manual backup/restore
PGPORT=

# source database name
PGDATABASE=

# database role for manual backup/restore
PGUSER=

# database role password for manual backup/restore
PGPASSWORD=

# archive directory for manual scripts
BACKUP_DIR=

# GitHub secret: deployment SSH hostname
DEPLOY_HOST=

# GitHub secret: deployment SSH account
DEPLOY_USER=

# GitHub secret: deploy SSH private key
DEPLOY_SSH_KEY=

# GitHub secret: pinned SSH host key
DEPLOY_KNOWN_HOSTS=


# Optional API waitlist-link origin; blank uses the first configured HTTPS CORS origin
PUBLIC_BOOKING_BASE_URL=

# Optional Web SignalR root URL; blank uses the public site origin routed by Caddy
REALTIME_BASE_URL=
